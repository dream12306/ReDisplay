# ReDisplay - Git Ignore Rules

# C/C++ Intermediate & Build Files
*.obj
*.o
*.pdb
*.ilk
*.idb
*.exp
*.lib
*.map
Host/*.obj
Host/*.pdb
Host/*.ilk

# Logs & Temporary Files
*.log
*.tmp
*.bak
scratch/

# Node.js / Electron Dependencies
node_modules/
GUI/node_modules/
npm-debug.log*
yarn-debug.log*

# Android / Client Intermediate Files
Client/bin/
Client/*.idsig
.gradle/
build/
*.dex
*.apk.idsig

# Standalone Distribution Packages
ReDisplay-Win64/
ReDisplay-*.zip

# Windows System Files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# IDE & Editor Settings
.vs/
.vscode/
.idea/
*.suo
*.user


# Electron build output
/dist/
/release/
*.blockmap
latest*.yml
builder-debug.yml
builder-effective-config.yaml

# Host test executables
/Host/*_test.exe

# Android local/build configuration
local.properties
.cxx/
.externalNativeBuild/
*.jks
*.keystore

# Local secrets and signing certificates
.env
.env.*
!.env.example
*.pfx
*.p12

# Other OS files
.DS_Store